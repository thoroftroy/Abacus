<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/wd_widget_bg" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/wd_lcd" android:padding="8dp" android:layout_marginBottom="4dp">
        <TextView android:id="@+id/w_expr" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="15sp" android:textColor="#991E2A12" android:maxLines="1" android:ellipsize="start" android:text="" />
        <TextView android:id="@+id/w_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="28sp" android:textStyle="bold" android:textColor="#FF1E2A12" android:maxLines="1" android:ellipsize="start" android:text="0" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/k_c" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_clear" android:gravity="center" android:text="C" android:textSize="18sp" android:textColor="#FFFFFFFF" />
        <TextView android:id="@+id/k_bs" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="⌫" android:textSize="18sp" android:textColor="#FF173A66" />
        <TextView android:id="@+id/k_lp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="(" android:textSize="18sp" android:textColor="#FF173A66" />
        <TextView android:id="@+id/k_rp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text=")" android:textSize="18sp" android:textColor="#FF173A66" />
        <TextView android:id="@+id/k_div" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="÷" android:textSize="18sp" android:textColor="#FF173A66" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/k_7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="7" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="8" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="9" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_mul" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="×" android:textSize="18sp" android:textColor="#FF173A66" />
        <TextView android:id="@+id/k_pct" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="%" android:textSize="18sp" android:textColor="#FF173A66" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/k_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="4" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="5" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="6" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_sub" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="−" android:textSize="18sp" android:textColor="#FF173A66" />
        <TextView android:id="@+id/k_pow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="^" android:textSize="18sp" android:textColor="#FF173A66" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/k_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="1" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="2" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="3" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="+" android:textSize="18sp" android:textColor="#FF173A66" />
        <TextView android:id="@+id/k_sqrt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="√" android:textSize="18sp" android:textColor="#FF173A66" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/k_0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="0" android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_dot" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key" android:gravity="center" android:text="." android:textSize="18sp" android:textColor="#FF16191D" />
        <TextView android:id="@+id/k_pi" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="π" android:textSize="18sp" android:textColor="#FF173A66" />
        <TextView android:id="@+id/k_ans" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_op" android:gravity="center" android:text="ans" android:textSize="18sp" android:textColor="#FF173A66" />
        <TextView android:id="@+id/k_eq" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/wd_key_eq" android:gravity="center" android:text="=" android:textSize="18sp" android:textColor="#FFFFFFFF" />
    </LinearLayout>
</LinearLayout>